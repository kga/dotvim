{
  "diag explain": {
    "prefix": "de",
    "body": ["diag explain ${1:value};"],
    "description": "diag explain"
  },
  "DDP": {
    "prefix": "dd",
    "body": ["use DDP { show_unicode => 1, use_prototypes => 0, colored => 1 }; p ${0}"],
    "description": "use DDP"
  },
  "package": {
    "prefix": "package",
    "body": [
      "package ${1:Package::Name};",
      "use strict;",
      "use warnings;",
      "use utf8;",
      "",
      "${0}",
      "",
      "1;"
    ],
    "description": "Perl package boilerplate"
  },
  "package test": {
    "prefix": "packaget",
    "body": [
      "package t::${0};",
      "use t::test -2;",
      "",
      "${1}"
    ],
    "description": "Test package boilerplate"
  },
  "subtest": {
    "prefix": "subtest",
    "body": [
      "subtest '${0}' => sub {",
      "};"
    ],
    "description": "subtest block"
  },
  "tests": {
    "prefix": "tests",
    "body": [
      "sub ${0} : Tests {",
      "}"
    ],
    "description": "Test::Class test method"
  },
  "args": {
    "prefix": "args",
    "body": [
      "args my \\$class => 'ClassName',",
      "     my \\$${0},",
      "     ;"
    ],
    "description": "Smart::Args args"
  },
  "kytprof": {
    "prefix": "kytprof",
    "body": [
      "use Devel::KYTProf;",
      "Devel::KYTProf->mute('DBI');",
      "Devel::KYTProf->mute('DBI::st');",
      "",
      "Devel::KYTProf->unmute('DBI');",
      "Devel::KYTProf->unmute('DBI::st');"
    ],
    "description": "Devel::KYTProf setup"
  }
}
